---
import Layout from '../layouts/Layout.astro';
const features=[['Assets','Track infrastructure assets with typed hardware details and relationships.'],['Hardware inventory','Record installed hardware and component attributes.'],['Spare components','Keep unattached components visible as spares.'],['Locations & racks','Organize locations and front/rear rack elevations.'],['Networking','Model interfaces, IP addresses, ports, and connections.'],['Relationships','Connect assets to represent dependencies.'],['Projects','Plan upgrades with work items, purchases, and updates.'],['MCP integration','Use the Streamable HTTP MCP endpoint for supported actions.'],['Authentication','Protect the application with local Better Auth sessions.']];
---
<Layout title="Features" active="features"><section class="wrap section prose"><div class="eyebrow">What V1 delivers</div><h1>Everything around the hardware.</h1><p class="muted">RackChief is focused on inventory and planning: a practical system of record for a homelab.</p><div class="grid">{features.map(([name,copy])=><div class="card"><h3>{name}</h3><p class="muted">{copy}</p></div>)}</div></section></Layout>
